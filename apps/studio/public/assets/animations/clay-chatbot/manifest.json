{
  "theme": "purple",
  "internal_theme_id": "classic",
  "default": true,
  "format": "animated WebP",
  "loop": "infinite",
  "asset_base": "../",
  "canvas_px": [
    315,
    311
  ],
  "states": {
    "idle": {
      "file": "idle.webp"
    },
    "blink": {
      "file": "blink.webp"
    },
    "rolling": {
      "file": "rolling.webp"
    },
    "pop-shape": {
      "file": "pop-shape.webp"
    },
    "interested": {
      "file": "interested.webp"
    },
    "judging": {
      "file": "judging.webp"
    },
    "concerned": {
      "file": "concerned.webp"
    }
  },
  "slash_commands": {
    "/spec": {
      "file": "spec.webp",
      "intent": "Write what the change must do before a plan"
    },
    "/plan": {
      "file": "plan.webp",
      "intent": "Write a spec before anything is built"
    },
    "/build": {
      "file": "build.webp",
      "intent": "Implement the approved plan"
    },
    "/run": {
      "file": "run.webp",
      "intent": "Start the local preview"
    },
    "/fix": {
      "file": "fix.webp",
      "intent": "Tell the agent what looks wrong"
    },
    "/docs": {
      "file": "docs.webp",
      "intent": "Open vision, design, and the ERD"
    },
    "/help": {
      "file": "help.webp",
      "intent": "List every Clay command"
    },
    "/clear": {
      "file": "clear.webp",
      "intent": "Wipe the chat, keep the agent"
    },
    "/search": {
      "file": "search.webp",
      "intent": "Find something in the app and docs"
    },
    "/think": {
      "file": "think.webp",
      "intent": "Reason first, then answer"
    },
    "/summarize": {
      "file": "summarize.webp",
      "intent": "Compress this thread to free context"
    },
    "/write": {
      "file": "write.webp",
      "intent": "Draft docs or copy, not application code"
    },
    "/code": {
      "file": "code.webp",
      "intent": "Open this project in the IDE with the change ready to review"
    },
    "/image": {
      "file": "image.webp",
      "intent": "Sketch a screen or illustration in words"
    },
    "/upload": {
      "file": "upload.webp",
      "intent": "Add files to this project"
    },
    "/settings": {
      "file": "settings.webp",
      "intent": "Show seat, model, and workspace"
    },
    "/reset": {
      "file": "new.webp",
      "intent": "Start a fresh agent"
    },
    "/seats": {
      "file": "seats.webp",
      "intent": "Choose Cursor, Codex, or Copilot"
    },
    "/seat": {
      "file": "seats.webp",
      "intent": "Choose Cursor, Codex, or Copilot",
      "alias_of": "/seats"
    },
    "/stop": {
      "file": "stop.webp",
      "intent": "Cancel the run in flight"
    },
    "/debug": {
      "file": "debug.webp",
      "intent": "Show the process log"
    }
  },
  "coverage": {
    "registered_commands": 20,
    "slash_spellings": 21
  },
  "note": "Every registered command and alias has a working animated WebP. Some clips share original motion frames but have distinct command file paths."
}
