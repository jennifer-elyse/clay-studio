{
  "format": "animated WebP RGBA",
  "loop": "infinite",
  "canvas_px": [
    315,
    311
  ],
  "states": {
    "idle": {
      "file": "idle.webp"
    },
    "rolling": {
      "file": "rolling.webp"
    },
    "pop-shape": {
      "file": "pop-shape.webp"
    },
    "blink": {
      "file": "blink.webp"
    },
    "interested": {
      "file": "interested.webp"
    },
    "judging": {
      "file": "judging.webp"
    },
    "concerned": {
      "file": "concerned.webp"
    }
  },
  "slash_commands": {
    "/help": {
      "file": "commands/help.webp",
      "intent": "display available commands"
